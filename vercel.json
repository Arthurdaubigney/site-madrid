{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo \"sin dependencias que instalar\"",
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(img|og|fonts|assets)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/version.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}